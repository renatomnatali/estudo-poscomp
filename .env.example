# Copie este arquivo para `.env.local` e preencha os valores reais.
# .env e .env.local estão no .gitignore — nunca commitar credenciais.

# --- Postgres / Neon ---
# Connection string com pooler (default para queries da app)
DATABASE_URL='postgresql://USER:PASSWORD@HOST/neondb?sslmode=require'
# Connection string direta (sem pooler) — usada por Prisma migrate
DATABASE_URL_UNPOOLED='postgresql://USER:PASSWORD@HOST_UNPOOLED/neondb?sslmode=require'

# Variantes geradas pelo Neon (usadas por @vercel/postgres se aplicável)
PGHOST='your-pooler-host.neon.tech'
PGHOST_UNPOOLED='your-direct-host.neon.tech'
PGUSER='neondb_owner'
PGDATABASE='neondb'
PGPASSWORD='your-password'

POSTGRES_URL='postgresql://USER:PASSWORD@HOST/neondb?sslmode=require'
POSTGRES_URL_NON_POOLING='postgresql://USER:PASSWORD@HOST_UNPOOLED/neondb?sslmode=require'
POSTGRES_USER='neondb_owner'
POSTGRES_HOST='your-pooler-host.neon.tech'
POSTGRES_PASSWORD='your-password'
POSTGRES_DATABASE='neondb'
POSTGRES_URL_NO_SSL='postgresql://USER:PASSWORD@HOST/neondb'
POSTGRES_PRISMA_URL='postgresql://USER:PASSWORD@HOST/neondb?connect_timeout=15&sslmode=require'

# --- Clerk (autenticação) ---
# Pegar em https://dashboard.clerk.com/ -> [App] -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx

# --- Admin / dev ---
# E-mails autorizados para o painel administrativo (separados por vírgula)
ADMIN_EMAILS=admin@example.com
# E-mail usado em dev quando Clerk está desabilitado
DEV_USER_EMAIL=dev@example.com
