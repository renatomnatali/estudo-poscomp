# Contrato de deploy — vars de autenticação (APR-3, PR A em diante)
# Regimes por variável: obrigatória em produção = ausente quebra/fail-closed em runtime.

# Sessão JWT — PRODUÇÃO EXIGE: ≥32 chars com entropia ≥4 bits/char OU 64 hex
# (openssl rand -hex 32). Sem ela, o boot de produção FALHA (sem fallback).
JWT_SECRET=

# HMAC de pseudonimização dos logs de segurança (lib/security-logger.ts) —
# PRODUÇÃO EXIGE no primeiro securityLog; sem ela, lança.
LOG_HASH_SECRET=

# Anti-bot Cloudflare Turnstile — PRODUÇÃO fail-closed: sem a secret,
# register/login/forgot NEGAM por desenho (turnstile.ts).
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Rate limit Upstash Redis — sem as duas, o limitador roda EM MEMÓRIA
# (teto por instância; alerta SYSTEM_RATE_LIMIT_DEGRADED no log).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# E-mail transacional (Resend) — rotas de verificação/recuperação (PR B).
RESEND_API_KEY=
# Remetente verificado no Resend (default do código: "Aprovado <noreply@aprovado.xyz>")
RESEND_FROM=

# URL pública base (getAppUrl) — opcional: cai para VERCEL_URL/localhost.
APP_URL=

# Override dos CIDRs de proxy confiáveis (lib/trusted-proxy.ts) — opcional;
# default: ranges oficiais da Cloudflare (o /0 é recusado).
# TRUSTED_PROXY_CIDRS=
